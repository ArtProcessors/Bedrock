SKIP_INSTALL = YES

DYLIB_COMPATIBILITY_VERSION = 1
DYLIB_CURRENT_VERSION = 1
DYLIB_INSTALL_NAME_BASE = @rpath

BR_BUNDLE_SHORT_VERSION_STRING = 0.3
BR_BUNDLE_VERSION = 1

DEFINES_MODULE = YES
INFOPLIST_FILE = Bedrock/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = com.nickforge.Bedrock
PRODUCT_NAME = Bedrock
ENABLE_MODULE_VERIFIER = YES
MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = gnu99 gnu++11

INFOPLIST_FILE = Bedrock/Info-$(BR_PLATFORM).plist
CODE_SIGN_IDENTITY =


// Warnings

CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE

